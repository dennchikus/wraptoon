MODE=DEV
SECRET_ADMIN_TOKEN=change_this_to_a_secure_token

# PostgreSQL (в Docker Compose хост должен быть 'db')
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=krl_db

# Frontend / CORS
FRONTEND_PORT=5500

# Telegram Notifications Bot & Proxy
TG_BOT_APIKEY=your_bot_token_from_botfather
TG_ADMIN_CHAT_IDS=[123456789]
TG_PROXY=http://login:password@ip:port
